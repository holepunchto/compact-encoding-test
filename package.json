{
  "name": "compact-encoding-test",
  "version": "0.1.0",
  "description": "Cross-language conformance vectors and normative spec for compact-encoding",
  "license": "Apache-2.0",
  "author": "Holepunch Inc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/compact-encoding-test.git"
  },
  "exports": {
    "./package": "./package.json",
    ".": "./index.js"
  },
  "imports": {
    "child_process": {
      "bare": "bare-subprocess",
      "default": "child_process"
    },
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    }
  },
  "files": [
    "index.js",
    "CODECS.md",
    "fixtures",
    "NOTICE"
  ],
  "scripts": {
    "generate": "node generate.js",
    "test": "npm run test:bare && npm run test:node",
    "test:bare": "brittle-bare test.js",
    "test:node": "brittle-node test.js",
    "lint": "prettier . --check && lunte",
    "format": "prettier . --write && lunte --fix"
  },
  "bugs": {
    "url": "https://github.com/holepunchto/compact-encoding-test/issues"
  },
  "homepage": "https://github.com/holepunchto/compact-encoding-test",
  "dependencies": {
    "bare-path": "^3.0.0"
  },
  "devDependencies": {
    "bare-fs": "^4.5.6",
    "bare-subprocess": "^5.2.3",
    "brittle": "^3.19.0",
    "compact-encoding": "3.5.0",
    "lunte": "^1.8.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  }
}
