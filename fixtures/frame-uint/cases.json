{
  "category": "combinators",
  "codec": {
    "name": "frame",
    "of": [
      {
        "name": "uint"
      }
    ]
  },
  "cases": [
    {
      "id": "frame-uint-value",
      "note": "a value needing one byte, announced as one byte",
      "input": {
        "value": 5
      },
      "rules": ["frame-byte-length-then-value"]
    },
    {
      "id": "frame-uint-wide-value",
      "note": "a value needing three bytes, so the count is bytes rather than values",
      "input": {
        "value": 300
      },
      "rules": ["frame-byte-length-then-value"]
    },
    {
      "id": "frame-uint-slack",
      "note": "three bytes announced where the value needs one, with a byte after the frame as well",
      "input": {
        "bytes": "0305ffff61"
      },
      "rules": ["frame-skips-to-its-end"]
    },
    {
      "id": "frame-uint-bounds",
      "note": "a value spanning three bytes inside a frame that announced one",
      "input": {
        "bytes": "01fd0100"
      },
      "rules": ["frame-bounds-its-value"]
    }
  ]
}
