{
  "category": "integers",
  "cases": [
    {
      "id": "uint8-value",
      "note": "a value inside the width",
      "input": {
        "value": 42
      },
      "rules": ["fixed-width-width-from-name"]
    },
    {
      "id": "uint8-max",
      "note": "the largest value one byte holds",
      "input": {
        "value": 255
      },
      "rules": ["fixed-width-width-from-name"]
    },
    {
      "id": "uint8-past-width",
      "note": "a value past the width",
      "input": {
        "value": 256
      },
      "rules": ["fixed-width-refuses-overflow"]
    },
    {
      "id": "uint8-negative",
      "note": "a negative, which no unsigned codec carries",
      "input": {
        "value": -1
      },
      "rules": ["unsigned-refuses-negative"]
    },
    {
      "id": "uint8-trailing-bytes",
      "note": "a byte after the width is satisfied",
      "input": {
        "bytes": "0161"
      },
      "rules": ["decode-consumes-its-form"]
    },
    {
      "id": "uint8-fraction",
      "note": "a fraction whose whole part the width holds, so the refusal is the codec's rather than the width's",
      "input": {
        "value": 1.5
      },
      "rules": ["integer-refuses-a-fraction"]
    }
  ]
}
